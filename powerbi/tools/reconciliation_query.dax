// Generated by python -m cookie_cats.powerbi_export from results/metrics.json.
// Run against the open CookieCats model; every row must say PASS.
EVALUATE
VAR t = UNION (
ROW ( "check_id", 1, "measure", "[Players]", "expected", 90189.0, "actual", [Players], "tol", 0.000000000000 ),
ROW ( "check_id", 2, "measure", "[D1 Retention]", "expected", 0.4452095044850259, "actual", [D1 Retention], "tol", 0.000000001000 ),
ROW ( "check_id", 3, "measure", "[D7 Retention Gate 30]", "expected", 0.19020134228187918, "actual", [D7 Retention Gate 30], "tol", 0.000000001000 ),
ROW ( "check_id", 4, "measure", "[D7 Retention Gate 40]", "expected", 0.18200004396667327, "actual", [D7 Retention Gate 40], "tol", 0.000000001000 ),
ROW ( "check_id", 5, "measure", "[D7 Difference pp]", "expected", -0.8201298315205913, "actual", [D7 Difference pp], "tol", 0.000001000000 ),
ROW ( "check_id", 6, "measure", "[D7 CI Low pp]", "expected", -1.3281552418885545, "actual", [D7 CI Low pp], "tol", 0.000001000000 ),
ROW ( "check_id", 7, "measure", "[D7 CI High pp]", "expected", -0.3121044211526281, "actual", [D7 CI High pp], "tol", 0.000001000000 ),
ROW ( "check_id", 8, "measure", "[D7 Holm p]", "expected", 0.003108499951228658, "actual", [D7 Holm p], "tol", 0.000001000000 ),
ROW ( "check_id", 9, "measure", "[D7 Players Lost per 100k]", "expected", 820.1298315205913, "actual", [D7 Players Lost per 100k], "tol", 0.001000000000 ),
ROW ( "check_id", 10, "measure", "[SRM p]", "expected", 0.008607987810836262, "actual", [SRM p], "tol", 0.000001000000 ),
ROW ( "check_id", 11, "measure", "CALCULATE ( [Gate 30 (control)], fact_tests[metric] = 'retention_1' )", "expected", 0.4481879194630872, "actual", CALCULATE ( [Gate 30 (control)], fact_tests[metric] = "retention_1" ), "tol", 0.000000001000 ),
ROW ( "check_id", 12, "measure", "CALCULATE ( [Gate 40 (test)], fact_tests[metric] = 'retention_1' )", "expected", 0.44228274967574577, "actual", CALCULATE ( [Gate 40 (test)], fact_tests[metric] = "retention_1" ), "tol", 0.000000001000 ),
ROW ( "check_id", 13, "measure", "CALCULATE ( [Bootstrap Resamples], fact_bootstrap_hist[metric] = 'retention_7' )", "expected", 10000.0, "actual", CALCULATE ( [Bootstrap Resamples], fact_bootstrap_hist[metric] = "retention_7" ), "tol", 0.000000000000 )
)
RETURN ADDCOLUMNS ( t, "result", IF ( ABS ( [actual] - [expected] ) <= [tol], "PASS", "FAIL" ) )
ORDER BY [check_id]
