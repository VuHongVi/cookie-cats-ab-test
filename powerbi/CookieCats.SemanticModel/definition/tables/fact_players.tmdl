	partition fact_players = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "fact_players.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"userid", Int64.Type}, {"version", type text}, {"arm_label", type text}, {"arm_order", Int64.Type}, {"sum_gamerounds", Int64.Type}, {"retention_1", Int64.Type}, {"retention_7", Int64.Type}, {"is_rounds_outlier", Int64.Type}}, "en-US")
