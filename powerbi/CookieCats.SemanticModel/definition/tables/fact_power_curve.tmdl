table fact_power_curve
	lineageTag: e407cf7a-ebe1-5e38-9afd-73b95dc1cf57

	column players_per_arm
		dataType: int64
		formatString: #,0
		lineageTag: 390a4e05-6d6b-58d5-829d-0c40babd95c1
		summarizeBy: none
		sourceColumn: players_per_arm

	column mde_pp
		dataType: double
		formatString: 0.00
		lineageTag: 7596a701-76d7-543d-8a23-bf89cf2014fd
		summarizeBy: none
		sourceColumn: mde_pp

	partition fact_power_curve = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "fact_power_curve.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"players_per_arm", Int64.Type}, {"mde_pp", type number}}, "en-US")
				in
				    Typed

