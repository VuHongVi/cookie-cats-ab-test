/// Home table for every report measure.
table _Measures
	lineageTag: 18bd8290-cc7f-5cb7-97df-31d0b32b6332

	/// Players randomised into the test.
	measure Players = COUNTROWS ( fact_players )
		formatString: #,0
		displayFolder: Test
		lineageTag: f23e29d3-86ae-53f9-b4f4-7ac0a8a45986

	/// Played again exactly 1 day after install.
	measure 'D1 Retention' = DIVIDE ( SUM ( fact_players[retention_1] ), [Players] )
		formatString: 0.00%
		displayFolder: Test
		lineageTag: 8b33fd12-ff0e-5815-a3c4-eb82417d0e00

	/// Played again exactly 7 days after install.
	measure 'D7 Retention' = DIVIDE ( SUM ( fact_players[retention_7] ), [Players] )
		formatString: 0.00%
		displayFolder: Test
		lineageTag: 42c8a131-f0c6-5f99-8892-64d1b97188bb

	measure 'D7 Retention Gate 30' = CALCULATE ( [D7 Retention], fact_players[version] = "gate_30" )
		formatString: 0.00%
		displayFolder: Test
		lineageTag: 065f6be5-e775-5bc7-a123-35374b80dc7f

	measure 'D7 Retention Gate 40' = CALCULATE ( [D7 Retention], fact_players[version] = "gate_40" )
		formatString: 0.00%
		displayFolder: Test
		lineageTag: 1ac65d98-e94f-5ede-a9ab-81f2ebd3b51a

	/// Gate 40 minus gate 30, percentage points.
	measure 'D7 Difference pp' = ( [D7 Retention Gate 40] - [D7 Retention Gate 30] ) * 100
		formatString: +0.00;-0.00
		displayFolder: Test
		lineageTag: f39a1435-f251-51c1-b2ea-a190b3726655

	/// 95% Wald interval, lower bound.
	measure 'D7 CI Low pp' = CALCULATE ( MAX ( fact_tests[ci_low_pp] ), fact_tests[metric] = "retention_7" )
		formatString: +0.00;-0.00
		displayFolder: Test
		lineageTag: 92a4ab53-ba4f-5314-ba64-7f83552abfb4

	/// 95% Wald interval, upper bound.
	measure 'D7 CI High pp' = CALCULATE ( MAX ( fact_tests[ci_high_pp] ), fact_tests[metric] = "retention_7" )
		formatString: +0.00;-0.00
		displayFolder: Test
		lineageTag: 3870c07a-b476-5bf8-9d0f-99c50452ca69

	/// Holm-adjusted p across D1 and D7.
	measure 'D7 Holm p' = CALCULATE ( MAX ( fact_tests[p_holm] ), fact_tests[metric] = "retention_7" )
		formatString: 0.000
		displayFolder: Test
		lineageTag: 4bf8e8cb-0abd-5323-81b6-9d7b23d1b5a7

	/// Fewer day-7 players per 100,000 installs with gate 40.
	measure 'D7 Players Lost per 100k' = - [D7 Difference pp] * 1000
		formatString: #,0
		displayFolder: Impact
		lineageTag: 7ee585c7-a561-583a-b444-7932da0081d4

	measure 'Players Lost per 100k Low' = CALCULATE ( MAX ( kpi_metrics[value] ), kpi_metrics[metric] = "players_lost_per_100k_low" )
		formatString: #,0
		displayFolder: Impact
		lineageTag: e7ad9f33-7307-59d6-bb0e-9690ea80bd37

	measure 'Players Lost per 100k High' = CALCULATE ( MAX ( kpi_metrics[value] ), kpi_metrics[metric] = "players_lost_per_100k_high" )
		formatString: #,0
		displayFolder: Impact
		lineageTag: 8af4f122-eb0e-5b76-a98a-bed1621ccb4d

	/// Chi-square test of the arm sizes against 50/50.
	measure 'SRM p' = CALCULATE ( MAX ( kpi_metrics[value] ), kpi_metrics[metric] = "srm_p" )
		formatString: 0.000
		displayFolder: Checks
		lineageTag: 96c53d7b-a10c-5d54-ba04-3592a4506ec3

	/// Retention of the metric on the row, gate 30.
	measure 'Gate 30 (control)' = CALCULATE ( DIVIDE ( SWITCH ( SELECTEDVALUE ( fact_tests[metric] ), "retention_1", SUM ( fact_players[retention_1] ), "retention_7", SUM ( fact_players[retention_7] ) ), COUNTROWS ( fact_players ) ), fact_players[version] = "gate_30" )
		formatString: 0.00%
		displayFolder: Test
		lineageTag: 3eeace3f-24bc-5270-a333-785f5a98194d

	/// Retention of the metric on the row, gate 40.
	measure 'Gate 40 (test)' = CALCULATE ( DIVIDE ( SWITCH ( SELECTEDVALUE ( fact_tests[metric] ), "retention_1", SUM ( fact_players[retention_1] ), "retention_7", SUM ( fact_players[retention_7] ) ), COUNTROWS ( fact_players ) ), fact_players[version] = "gate_40" )
		formatString: 0.00%
		displayFolder: Test
		lineageTag: 1410ed79-7553-560e-a0d1-ec591e2cf512

	measure 'Bootstrap Resamples' = SUM ( fact_bootstrap_hist[resamples] )
		formatString: #,0
		displayFolder: Evidence
		lineageTag: 24d1f2ad-46c2-5fb8-be48-87f88757b989

	/// 1 when the bin centre is inside the bootstrap 95% interval.
	measure 'In 95% Interval' = MAX ( fact_bootstrap_hist[in_ci] )
		formatString: 0
		displayFolder: Evidence
		lineageTag: 4f29ff9f-f23c-5e77-83b3-2b2d22db9131

	/// Share of the arm with at least N rounds.
	measure 'Share At Least' = SUM ( fact_rounds_survival[share_at_least] )
		formatString: 0%
		displayFolder: Engagement
		lineageTag: a161d908-236a-57a4-ac2a-6ceb251fc701

	/// 80% power, two-sided alpha 0.05.
	measure 'Smallest detectable change' = SUM ( fact_power_curve[mde_pp] )
		formatString: 0.00
		displayFolder: Power
		lineageTag: da71a558-415c-5afb-92c5-f1a04f7107a3

	/// Size of the observed day-7 change.
	measure 'Observed D7 effect' = ABS ( [D7 Difference pp] )
		formatString: 0.00
		displayFolder: Power
		lineageTag: f139d3d6-5289-597d-a44f-fa44d85a86f7

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c2a9bb14-cd84-55d3-b85e-a1d8d0305ff9
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = Int64.Type], {})
				in
				    Source

